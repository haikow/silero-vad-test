# Generated by WQ Kconfig Tool
CONFIG_VARIANT_DIR="build/7036AC/silero"
# CONFIG_DEPRECATED_USED is not set
CONFIG_SMALL_IRAM=y
CONFIG_RISCV_TOOLCHAIN_GCC_VERSION_10_2_0=y
# CONFIG_XT_TOOLCHAIN_XT_CLANG is not set
CONFIG_XT_TOOLCHAIN_GCC=y
CONFIG_BUILD_PATCH_BCORE=y
CONFIG_XTENSA_ENABLE_SECTION_ORDER=y
CONFIG_XTENSA_SECTION_ORDER_FILE="config/7036AC/dsp_section_order.txt"
CONFIG_DCORE_DISABLE_IRAM_TEXT=y
CONFIG_CHIP_PKG_SEL_WQ7036AC=y
CONFIG_SHARE_RAM_LAYOUT_0K_256K=y
CONFIG_ACORE_RAM_LENGTH=0x15000
CONFIG_ENABLE_DCORE_DCACHE=y
CONFIG_ACORE_PSRAM_LENGTH=0x160000
CONFIG_ACORE_PSRAM_DATA_SECTION=y
CONFIG_ACORE_PSRAM_BSS_SECTION=y
CONFIG_BCORE_PSRAM_DATA_SECTION=y
CONFIG_BCORE_PSRAM_BSS_SECTION=y
CONFIG_AUDIO_HARDWARE_DRE=y
CONFIG_AUDIO_PA_USER_CTL=y
CONFIG_GTP_BCORE_BUFF_SIZE=0x1400
CONFIG_GTP_TX_MIN_TX_MTU=1024
CONFIG_GTP_TX_DEF_TX_MTU=1024
CONFIG_GTP_TX_MAX_TX_MTU=1024
CONFIG_MBEDTLS_ENABLE=y
CONFIG_PIPELINE_STREAM_MAX_NUM=18
CONFIG_SAFE_C_LIB_ENABLE=y
CONFIG_USER_RODATA_SECTION_ACORE="cli_cmd,app_module,observers"
CONFIG_USER_RODATA_SECTION_DCORE="wqsh_cmd"
CONFIG_DEBUG_ILLEGAL_INSTRUCTION_FLASH_DUMP=y
CONFIG_PACKAGE_NAME="ai-recorder-stub"
CONFIG_ECONN_ENABLE=y
# CONFIG_TWS_ENABLE is not set
# CONFIG_APP_INEAR_ENABLE is not set
CONFIG_LINT_DISABLE_MOD="rpc,gfps,riscv,audiohal,audiohw,driverhw,driverhal,os_shim,freertos,heap,lzma,cpu_usage,utils,bootmap,share_task,storage_controller,dbglog,audsys,key_value,generic_transmission,mbedcrypto,mbedx509,mbedtls,platform_mod,amp,startup,power_mgnt,ota,wqlibc,caldata,bluetooth,dfs,cjson,wq_debug,sd_card,utils,dfs_mgnt,safeclib"
CONFIG_RECORDSV_ENABLE=y
CONFIG_RECORDSV_ENCODER_OPUS=y
CONFIG_WQ_TRANS_ENABLE=y
CONFIG_WIND_DETECT_ENABLE=y
CONFIG_WIND_DETECT_3_0_ENABLE=y
CONFIG_AS_SOFT_HOWL_DETECT_ENABLE=y
CONFIG_SOFT_DUMP_BLOCK_SIZE=2148
# CONFIG_ANC_DRC_DBG_ENABLE is not set
CONFIG_EXT_TRANS_ENABLE=y
CONFIG_EXT_TRANS_IO_UART_ENABLE=y
CONFIG_EXT_TRANS_UART_BAUDRATE=2000000
CONFIG_EXT_TRANS_IO_FLASH_ENABLE=y
CONFIG_FREERTOS_ISR_CALL_CHECK=y

# ---- Silero VAD 集成(自定义) ----
CONFIG_VAD_ENABLE=y
CONFIG_RING_ALLOCATE_CFG=2
CONFIG_PIPELINE_STREAM_MAX_NUM=20
CONFIG_DCORE_GVAD_ENABLE=y
